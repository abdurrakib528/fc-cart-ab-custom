<ab-product-modal id="ab-product-modal">
  <dialog class="ab-modal__dialog" aria-label="Product quick view" aria-modal="true">
    <div class="ab-modal__backdrop" data-ab-modal-close></div>

    <div class="ab-modal__panel" role="document">
      <button
        class="ab-modal__close-btn"
        type="button"
        data-ab-modal-close
        aria-label="Close"
      >
        {% render 'icon', icon: 'cart-modal-close' %}
      </button>

      <div class="ab-modal__content" aria-live="polite" aria-atomic="true"></div>
    </div>
  </dialog>
</ab-product-modal>

{% if product != blank %}
  <div class="ab-modal__product" data-ab-modal-inner>
    <div class="ab-modal__media">
      {% if product.featured_media %}
        {{
          product.featured_media
          | image_url: width: 600
          | image_tag:
            loading: 'eager',
            width: 600,
            height: 600,
            class: 'ab-modal__product-img',
            alt: product.featured_media.alt
          | default: product.title
          | escape
        }}
      {% else %}
        <div class="ab-modal__img-placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'ab-modal__placeholder-svg' }}
        </div>
      {% endif %}
    </div>

    <div class="ab-modal__info">
      <h2 class="ab-modal__title">{{ product.title }}</h2>

      <div class="ab-modal__price">
        {% assign current_variant = product.selected_or_first_available_variant %}
        {% if current_variant.compare_at_price > current_variant.price %}
          <s class="ab-modal__price-was">{{ current_variant.compare_at_price | money }}</s>
          <span class="ab-modal__price-sale">{{ current_variant.price | money }}</span>
        {% else %}
          <span class="ab-modal__price-regular">{{ current_variant.price | money }}</span>
        {% endif %}
      </div>

      {% if product.description != blank %}
        <div class="ab-modal__desc-body rte">{{ product.description }}</div>
      {% endif %}

      <a class="ab-modal__full-btn" href="{{ product.url }}">
        View full details
        {% render 'icon', icon: 'cart-modal-arrow-right' %}
      </a>
    </div>
  </div>
{% endif %}

<style>
  ab-product-modal {
    display: contents;
  }

  body.ab-modal-open {
    overflow: hidden;
  }

  [data-ab-modal-inner] {
    display: none;
  }

  .ab-modal__content [data-ab-modal-inner] {
    display: grid;
  }

  .ab-modal__error {
    text-align: center;
    padding: 4rem 2rem;
    opacity: 0.55;
    font-size: 1.4rem;
  }

  .ab-modal__dialog {
    position: fixed;
    inset: 0;
    z-index: 9999;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .ab-modal__dialog:not([open]) {
    display: none;
  }

  .ab-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.48);
    cursor: pointer;
  }

  @supports (backdrop-filter: blur(4px)) {
    .ab-modal__backdrop {
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      background: rgba(0, 0, 0, 0.36);
    }
  }

  .ab-modal__panel {
    position: relative;
    z-index: 1;
    width: min(50rem, calc(100vw - 2.4rem));
    height: min(30rem, calc(100dvh - 10rem));
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-background, #fff);
    border-radius: 1rem;
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.18);
    animation: ab-modal-in 0.2s cubic-bezier(0.4, 0, 0.2, 1) both;
  }
  @keyframes ab-modal-in {
    from {
      opacity: 0;
      transform: translateY(1.2rem) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .ab-modal__close-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    min-height: auto;
    padding: 0;
    background: var(--color-background, #fff);
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 50%;
    cursor: pointer;
    color: currentColor;
    transition: background 0.12s, border-color 0.12s, transform 0.12s;
    flex-shrink: 0;
  }

  .ab-modal__close-btn svg {
    width: 12px;
  }
  .ab-modal__close-btn:hover {
    background: rgba(0, 0, 0, 0.05);
    border-color: rgba(0, 0, 0, 0.22);
    transform: scale(1.1);
  }

  .ab-modal__content {
    flex: 1;
    overflow-y: auto;
    padding: 2rem;
    transition: opacity 0.15s ease;
  }

  .ab-modal__skeleton {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    height: 100%;
  }

  .ab-modal__skeleton-img {
    border-radius: 10px;
    align-self: stretch;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.06) 25%, rgba(0, 0, 0, 0.1) 50%, rgba(0, 0, 0, 0.06) 75%);
    background-size: 200% 100%;
    animation: ab-shimmer 1.4s infinite;
  }

  .ab-modal__skeleton-lines {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    padding-top: 0.4rem;
  }

  .ab-modal__skeleton-line {
    height: 1.4rem;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.07);
    animation: ab-shimmer 1.4s infinite;
  }

  .ab-modal__skeleton-line:nth-child(1) {
    width: 40%;
  }
  .ab-modal__skeleton-line:nth-child(2) {
    width: 75%;
    animation-delay: 0.08s;
  }
  .ab-modal__skeleton-line:nth-child(3) {
    width: 30%;
    animation-delay: 0.16s;
  }
  .ab-modal__skeleton-line:nth-child(4) {
    width: 60%;
    animation-delay: 0.24s;
  }
  .ab-modal__skeleton-line:nth-child(5) {
    width: 85%;
    animation-delay: 0.32s;
  }
  .ab-modal__skeleton-line:nth-child(6) {
    width: 50%;
    animation-delay: 0.4s;
  }

  @keyframes ab-shimmer {
    to {
      background-position: -200% 0;
    }
  }

  @media (max-width: 749px) {
    .ab-modal__skeleton {
      grid-template-columns: 1fr;
      height: auto;
      gap: 0px;
    }
    .ab-modal__skeleton-lines {
      gap: 10px;
      padding-top: 10px;
    }
    .ab-modal__skeleton-img {
      aspect-ratio: 1;
      height: auto;
      max-height: 300px;
    }
  }

  .ab-modal__product {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    height: 100%;
    animation: ab-fade-in 0.18s ease both;
  }

  @keyframes ab-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (max-width: 749px) {
    .ab-modal__product {
      grid-template-columns: 1fr;
      height: auto;
      gap: 0px;
    }
    .ab-modal__content {
      padding: 1rem;
    }
    .ab-modal__close-btn {
      right: 5px;
      top: 5px;
    }
  }

  .ab-modal__media {
    overflow: hidden;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.04);
    align-self: stretch;
  }

  .ab-modal__product-img {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 10px;
    object-fit: cover;
    aspect-ratio: 1;
  }

  .ab-modal__img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ab-modal__placeholder-svg {
    width: 60%;
    opacity: 0.3;
  }

  .ab-modal__info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
  }

  .ab-modal__vendor {
    font-size: 12px;
    text-transform: uppercase;
    color: #999;
  }

  .ab-modal__title {
    font-size: 24px;
    margin: 0px;
  }

  .ab-modal__price-regular {
    font-size: 20px;
    font-weight: 800;
    margin: 0;
    display: block;
  }

  .ab-modal__price-was {
    color: #f69898;
  }
  .ab-modal__form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .ab-modal__option-group {
    border: none;
    padding: 0;
    margin: 0;
  }

  .ab-modal__option-name {
    font-size: 13px;
    text-transform: uppercase;
    margin-bottom: 5px;
  }

  .ab-modal__desc-body p {
    font-size: 13px;
    line-height: 17px;
    margin-bottom: 10px;
  }

  .ab-modal__desc-body ul {
    margin: 0;
    font-size: 13px;
    padding-left: 15px;
  }

  .ab-modal__desc-body ul li {
    font-size: 13px;
    line-height: 20px;
  }
  .ab-modal__option-list {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 5px;
  }

  .ab-modal__option-pill {
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 8px 15px;
    cursor: pointer;
    font-size: 13px;
  }

  .ab-modal__option-radio {
    position: absolute;
    left: -10000px;
  }

  .ab-modal__option-radio:checked + label {
    background: var(--ab-accent);
    border: var(--ab-accent);
    color: #fff;
  }

  .ab-modal__atc-btn {
    display: block;
    height: auto;
    min-height: auto;
    border: 1px solid var(--ab-accent);
    border-radius: 6px;
    background: var(--ab-accent);
    color: #fff;
    padding: 10px 30px;
    transition: all 0.3s;
    font-size: 13px;
    text-transform: uppercase;
    font-weight: 700;
    cursor: pointer;
    width: 100%;
    margin-bottom: 20px;
  }

  .ab-modal__atc-btn:hover {
    opacity: 0.8;
    box-shadow: 0 0 0 1px var(--ab-accent);
  }

  .ab-modal__full-btn {
    font-size: 13px;
    display: inline-flex;
    align-items: center;
    margin: 0px;
    gap: 5px;
    color: #333;
    width: max-content;
    transition: all 0.3s;
  }

  .ab-modal__full-btn svg {
    width: 10px;
    transition: all 0.3s;
  }

  .ab-modal__full-btn:hover svg {
    margin-left: 2px;
    color: var(--ab-accent);
  }
  .ab-modal__full-btn:hover {
    color: var(--ab-accent);
  }

  [data-ab-modal-trigger][aria-busy='true'] {
    position: relative;
    pointer-events: none;
    opacity: 0.7;
  }

  [data-ab-modal-trigger][aria-busy='true'] .ab-trigger-label {
    opacity: 0;
  }

  [data-ab-modal-trigger][aria-busy='true']::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1.2em;
    height: 1.2em;
    margin-top: -0.6em;
    margin-left: -0.6em;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    animation: ab-spin 0.6s linear infinite;
  }

  @keyframes ab-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 749px) {
    .ab-modal__panel {
      width: 90%;
      height: max-content;
      border-radius: 1rem;
    }

    .ab-modal__info {
      gap: 10px;
      padding-top: 10px;
    }
    .ab-modal__media,
    .ab-modal__skeleton-img {
      height: 200px;
      object-fit: cover;
      object-position: center;
    }
  }
</style>

<script>
  (() => {
    'use strict';

    const SECTION_ID = {{ section.id | json }};
    const fetchCache = new Map();
    let activeFetch = null;

    class AbProductModal extends HTMLElement {

      connectedCallback() {
        this.dialog  = this.querySelector('.ab-modal__dialog');
        this.content = this.querySelector('.ab-modal__content');

        this.setupCloseHandlers();
        this.setupTriggerHandler();
      }

      setupCloseHandlers() {
        this.dialog.addEventListener('click', (event) => {
          if (event.target.closest('[data-ab-modal-close]')) {
            event.stopPropagation();
            this.closeModal();
          }
        });

        this.dialog.addEventListener('cancel', (event) => {
          event.preventDefault();
          this.closeModal();
        });
      }

      
      setupTriggerHandler() {
        document.addEventListener('click', (event) => {
          const trigger = event.target.closest('[data-ab-modal-trigger]');
          if (!trigger) return;

          event.stopPropagation();
          this.openModal(trigger);
        });
      }

      async openModal(trigger) {
        const productUrl = trigger.dataset.productUrl;
        if (!productUrl) return;

        if (activeFetch) {
          activeFetch.abort();
        }
        activeFetch = new AbortController();

        this.showSkeleton();
        this.dialog.showModal();
        document.body.classList.add('ab-modal-open');

        this.dialog.addEventListener('close', () => {
          trigger.focus();
        }, { once: true });

        try {
          const html = await this.fetchProduct(productUrl, activeFetch.signal);
          this.renderProduct(html);
        } catch (error) {
          if (error.name !== 'AbortError') {
            this.renderError();
          }
        } 
      }

      closeModal() {
        this.dialog.close();
        document.body.classList.remove('ab-modal-open');
        setTimeout(() => {
          this.content.innerHTML = '';
        }, 200);
      }

      async fetchProduct(productUrl, signal) {
        const handle = productUrl.split('/products/')[1]?.split('?')[0];

        if (!handle) {
          throw new Error('Could not extract product handle from URL: ' + productUrl);
        }

        if (fetchCache.has(handle)) {
          return fetchCache.get(handle);
        }

        const url = `/products/${handle}?section_id=${SECTION_ID}`;
        const response = await fetch(url, { signal });

        if (!response.ok) {
          throw new Error('Fetch failed with status ' + response.status);
        }

        const html = await response.text();

        fetchCache.set(handle, html);

        return html;
      }

      showSkeleton() {
        this.content.setAttribute('aria-busy', 'true');
        this.content.innerHTML = `
          <div class="ab-modal__skeleton" aria-hidden="true">
            <div class="ab-modal__skeleton-img"></div>
            <div class="ab-modal__skeleton-lines">
              <div class="ab-modal__skeleton-line"></div>
              <div class="ab-modal__skeleton-line"></div>
              <div class="ab-modal__skeleton-line"></div>
              <div class="ab-modal__skeleton-line"></div>
              <div class="ab-modal__skeleton-line"></div>
              <div class="ab-modal__skeleton-line"></div>
            </div>
          </div>
        `;
      }

  
      renderProduct(html) {
        const temp = document.createElement('div');
        temp.innerHTML = html;

        const productInner = temp.querySelector('[data-ab-modal-inner]');

        if (!productInner) {
          this.renderError();
          return;
        }

        this.content.innerHTML = '';
        this.content.appendChild(productInner);
        this.content.removeAttribute('aria-busy');
      }

      renderError() {
        this.content.removeAttribute('aria-busy');
        this.content.innerHTML = `
          <p class="ab-modal__error">
            Could not load product details. Please try again.
          </p>
        `;
      }

    }
    if (!customElements.get('ab-product-modal')) {
      customElements.define('ab-product-modal', AbProductModal);
    }

  })();
</script>

{% schema %}
{
  "name": "AB Product Modal",
  "class": "ab-product-modal-section"
}
{% endschema %}